@model Wypozyczalnia.Models.ViewModels.UserDashBoardViewModel

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <div>
                <input asp-for="User.Id" type="hidden" />
            </div>
            <div class="form-group">
                <label class="control-label">Generate One-Time Password</label>
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-info">Generate</button>
                @{
                    if (Model.Otp is not null)
                    {
                        <span>@Model.Otp</span>
                    }
                }
            </div>
        </form>
    </div>
</div>


